{
  // U Hirable on Cloudflare Workers: the site's files plus one small script (worker/index.js).
  // The name must match the Worker's name in the Cloudflare dashboard.
  "name": "uhirable",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // A page address that matches no file always reaches worker/index.js, in the browser too.
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Keep every link exactly as it is today: /jobs.html stays /jobs.html (no automatic redirect).
    "html_handling": "none"
  },
  // Open to Work profiles (worker/talent.js). The database holds candidates' data, so it is not part of this repository.
  "d1_databases": [
    { "binding": "DB", "database_name": "uhirable-talent", "database_id": "82f84bc9-9bc4-429c-8942-e718d909242e" }
  ],
  // Lets worker/talent.js email the owner when a new profile is waiting (through the domain's Email Routing).
  "send_email": [{ "name": "MAIL" }]
}
